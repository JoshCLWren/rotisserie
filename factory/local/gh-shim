#!/usr/bin/env python3
"""Container gh: forwards argv to the host proxy. There is no GitHub token here."""

import json
import os
import sys
import urllib.request

argv = sys.argv[1:]
stdin = ""
for flag in ("--input", "--body-file", "-F"):
    if flag in argv and argv[argv.index(flag) + 1 : argv.index(flag) + 2] == ["-"]:
        stdin = sys.stdin.read()
request = urllib.request.Request(
    os.environ.get("LOCAL_GH_PROXY", "http://host.docker.internal:8787"),
    data=json.dumps({"argv": argv, "stdin": stdin}).encode(),
    headers={"Content-Type": "application/json"},
)
with urllib.request.urlopen(request, timeout=180) as response:
    result = json.load(response)
sys.stdout.write(result["stdout"])
sys.stderr.write(result["stderr"])
raise SystemExit(result["code"])
